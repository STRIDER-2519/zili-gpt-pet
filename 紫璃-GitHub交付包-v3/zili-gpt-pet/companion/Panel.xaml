<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="紫璃 · 陪伴面板" Width="132" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei" FontSize="12"
        Foreground="#493A66">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#EEE7FB"/>
      <Setter Property="Foreground" Value="#695092"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#9B7BC8"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="BorderBrush" Value="#EEE7F8"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#F9F6FF"/>
      <Setter Property="BorderBrush" Value="#DDD1EF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="5,4"/>
      <Setter Property="Width" Value="43"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <Border x:Name="Shell" Margin="5" Background="#F8F5FF" CornerRadius="14" BorderBrush="#DFD2F2" BorderThickness="1">
    <Border.Effect><DropShadowEffect Color="#69528A" BlurRadius="15" ShadowDepth="2" Opacity="0.18"/></Border.Effect>
    <StackPanel>
      <Grid x:Name="DragHeader" Visibility="Collapsed" Margin="12,9,10,8" Background="Transparent" Cursor="SizeAll">
        <Grid.ColumnDefinitions><ColumnDefinition Width="57"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image x:Name="PetImage" Width="53" Height="58" Stretch="Uniform" IsHitTestVisible="False"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock Text="紫璃" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock x:Name="HeaderSubtitle" Text="陪你工作，也陪你休息" FontSize="10.5" Foreground="#9C89B4" Margin="0,4,0,0"/>
        </StackPanel>
        <Button x:Name="CollapseButton" Grid.Column="2" Content="−" FontSize="18" Padding="9,2" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="收起面板" AutomationProperties.Name="收起面板"/>
        <Button x:Name="CloseButton" Grid.Column="3" Content="×" FontSize="17" Padding="9,2" VerticalAlignment="Center" Background="Transparent" ToolTip="退出面板" AutomationProperties.Name="退出面板"/>
      </Grid>
      <ScrollViewer x:Name="FullBody" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="720">
        <StackPanel Margin="15,0,15,14">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="陪伴计时" FontWeight="SemiBold" FontSize="14"/>
              <DockPanel Margin="0,9,0,0">
                <Button x:Name="PauseButton" DockPanel.Dock="Right" Content="暂停" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Text="本次陪伴" FontSize="10.5" Foreground="#A38FBB"/>
                  <TextBlock x:Name="SessionTime" Text="00:00:00" FontSize="27" FontWeight="SemiBold" Foreground="#7957A9" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TodayTime" Text="今日累计  00:00:00" FontSize="11"/>
                <TextBlock x:Name="TimerStatus" Grid.Column="1" Text="陪伴中" Foreground="#9B86B3" FontSize="11"/>
              </Grid>
              <TextBlock Text="面板运行时累计 · 手动暂停 / 锁屏 / 休眠不计" TextWrapping="Wrap" FontSize="9.5" Foreground="#AB9BBB" Margin="0,9,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <CheckBox x:Name="RestEnabled" DockPanel.Dock="Right" IsChecked="True" Content="开启" VerticalAlignment="Center" Foreground="#8E76A9" AutomationProperties.Name="开启休息提醒"/>
                <TextBlock Text="休息提醒" FontWeight="SemiBold" FontSize="14"/>
              </DockPanel>
              <TextBlock x:Name="RestStatus" Text="眼睛也要休息一下呀～" FontSize="11" Foreground="#9B86B3" Margin="0,10,0,0" TextWrapping="Wrap"/>
              <ProgressBar x:Name="RestProgress" Height="5" Maximum="100" Value="0" Margin="0,11,0,2" Background="#F1EBF8" Foreground="#B295D4" BorderThickness="0"/>
            </StackPanel>
          </Border>
          <Expander x:Name="SettingsExpander" Header="提醒设置" Foreground="#8E76A9" FontSize="11" Margin="3,0,3,5">
            <StackPanel Margin="0,10,0,2">
              <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="连续陪伴" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBox x:Name="IntervalInput" Text="45" AutomationProperties.Name="休息间隔分钟"/>
                <TextBlock Text="分钟后提醒" VerticalAlignment="Center" Margin="7,0,0,0"/>
              </WrapPanel>
              <CheckBox x:Name="Pinned" IsChecked="True" Content="面板保持在其他窗口上方" Margin="0,10,0,0"/>
              <Button x:Name="ApplySettings" Content="保存设置" HorizontalAlignment="Left" Margin="0,10,0,0"/>
              <TextBlock x:Name="SettingsMessage" FontSize="10" Foreground="#9B86B3" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
          </Expander>
          <TextBlock Text="拖动顶部摆在紫璃旁 · 位置自动保存" HorizontalAlignment="Center" Foreground="#AB9BBB" FontSize="9.5" Margin="0,5,0,0"/>
        </StackPanel>
      </ScrollViewer>
      <DockPanel x:Name="CompactBody" Margin="9,9,9,11">
        <StackPanel>
          <Grid x:Name="MiniDragHeader" Background="Transparent" Cursor="SizeAll">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
            <TextBlock Text="紫璃" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Button x:Name="MiniDetails" Grid.Column="1" Content="⋯" FontSize="14" Padding="1,0" Height="20" ToolTip="查看详情与设置" AutomationProperties.Name="查看详情与设置"/>
            <Button x:Name="MiniClose" Grid.Column="2" Content="×" FontSize="13" Padding="1,0" Height="20" Background="Transparent" ToolTip="退出面板" AutomationProperties.Name="退出面板"/>
          </Grid>
          <TextBlock Text="本次陪伴" FontSize="9.5" Foreground="#9C89B4" Margin="0,11,0,5"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="23"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="CompactInfo" Text="00:00" FontSize="21" FontWeight="Medium" Foreground="#7957A9" VerticalAlignment="Center"/>
            <Button x:Name="CompactPause" Grid.Column="1" Content="Ⅱ" Padding="2,0" Height="25" FontSize="14" ToolTip="暂停计时" AutomationProperties.Name="暂停计时"/>
          </Grid>
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
